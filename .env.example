EXA_API_KEY=
# Shared by everyone on this server process. New calls start immediately; no queue.
EXA_MAX_CONCURRENT_REQUESTS=24
# Every HTTP attempt, including an automatic 429 retry, uses this rolling budget.
EXA_MAX_REQUESTS_PER_HOUR=300
# Optional canonical public origin for a custom domain. Render sets
# RENDER_EXTERNAL_URL automatically for the default onrender.com address.
APP_ORIGIN=
